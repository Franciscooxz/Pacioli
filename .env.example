# ---------------------------------------------------------------------------
# contaflow - variables de entorno. Copia este archivo a .env y ajusta valores.
# NUNCA subas el .env real al repositorio.
# ---------------------------------------------------------------------------

# --- Nuestra base PostgreSQL (separada de la de Odoo) ---
POSTGRES_USER=contaflow
POSTGRES_PASSWORD=cambia_esto_en_local
POSTGRES_DB=contaflow

# URL async que usa la API (FastAPI + SQLAlchemy async con asyncpg).
# El host "postgres" es el nombre del servicio en docker-compose.
DATABASE_URL=postgresql+asyncpg://contaflow:cambia_esto_en_local@postgres:5432/contaflow

# --- Redis (broker y backend de Celery) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO (almacenamiento S3-compatible del XML/PDF crudo) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia_esto_en_local
MINIO_SECURE=false
MINIO_BUCKET=contaflow-raw

# --- Cifrado en reposo (Fernet) ---
# Clave urlsafe base64 de 32 bytes. Genera una nueva con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=cambia_esto_por_una_clave_generada
# Claves viejas (separadas por coma) para descifrar durante una rotacion. Vacio normalmente.
FERNET_KEYS_SECONDARY=

# --- Autenticacion (JWT) ---
# Genera un secreto con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_secreto_generado
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Base EXCLUSIVA de Odoo (no la compartimos con la nuestra) ---
ODOO_DB_PASSWORD=cambia_esto_en_local

# --- Observabilidad ---
LOG_LEVEL=INFO
LOG_JSON=true
# Deja SENTRY_DSN vacio para desactivar Sentry en local.
SENTRY_DSN=
# Si defines METRICS_TOKEN, /metrics exige Authorization: Bearer <token>. Vacio = abierto.
METRICS_TOKEN=

# --- LLM (residuo ambiguo). Vacio = desactivado. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- CORS (frontend) ---
CORS_ORIGINS=http://localhost:3000

# --- General ---
ENVIRONMENT=development
